# 이 파일은 "앱이 어떤 비밀값·설정값을 필요로 하는지" 알려 주는 견본입니다.
# 진짜 값은 절대 여기에 적지 않습니다. (이 파일은 git에 올라갑니다)
#
# 사용법: 아래 항목의 이름을 .env 파일에 복사해 값을 채워 넣으세요.
#   - .env 는 git에 올라가지 않습니다.
#   - 배포할 때는 같은 이름으로 Vercel 환경변수에 등록합니다.
#   - NEXT_PUBLIC_ 으로 시작하는 값만 브라우저에 공개됩니다. 나머지는 서버에서만 읽힙니다.
#
# 앱이 실제로 쓰는 값만 적었습니다. 개발 도구용 토큰(GITHUB_TOKEN, VERCEL_TOKEN,
# SUPABASE_ACCESS_TOKEN 등)은 앱이 쓰지 않으므로 Vercel에 등록하지 않습니다.

# ─────────────────────────────────────────────
# Supabase (카드 저장, 내 로그인, Claude 연결 승인)
# ─────────────────────────────────────────────

# Supabase 프로젝트 주소 (브라우저에 공개돼도 됩니다)
# 확인: Supabase 대시보드 → 프로젝트 설정의 API 항목
NEXT_PUBLIC_SUPABASE_URL=

# 공개용 키(publishable key). 로그인과 "내 행만 보기" 규칙(RLS) 아래에서만 쓰이므로
# 브라우저에 공개돼도 됩니다.
# 확인: Supabase 대시보드 → 프로젝트 설정의 API 키 항목
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 참고: 서버 전용 비밀 키(SUPABASE_SECRET_KEY)는 처음에는 등록하지 않습니다.
# 호출 횟수도 로그인한 내 권한으로 세기 때문입니다. 정말 필요해질 때만 추가합니다.

# ─────────────────────────────────────────────
# Claude API (카드 분류 보정) — 서버 전용
# ─────────────────────────────────────────────

# 확인: https://platform.claude.com/settings/keys 에서 키를 만들고 복사 (sk-ant- 로 시작)
# 기본 모델은 claude-haiku-5-5 입니다.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# 내 계정과 배포 주소
# ─────────────────────────────────────────────

# 내 계정 번호 — 서버 전용. "토큰 주인이 나인지" 확인할 때 비교합니다.
# 확인: 로그인 계정을 만든 뒤 Supabase 대시보드 → Authentication → Users 에서 내 계정의 ID 복사
OWNER_USER_ID=

# 앱 주소. Claude에게 알려 주는 안내문과 로그인 주소 설정에 쓰입니다.
# 로컬: http://localhost:3000   배포 후: https://(배포 주소)
APP_URL=

# ─────────────────────────────────────────────
# 개발 중 로그인 시험용 — 앱이 쓰는 값이 아니다
# ─────────────────────────────────────────────

# 내가 Supabase에 만든 로그인 계정. 개발하면서 로그인이 되는지 시험할 때만 쓴다.
# 앱 서버는 읽지 않고, Vercel에도 등록하지 않는다. 채팅이나 문서에 적지 않는다.
TRAIL_LOGIN_EMAIL=
TRAIL_LOGIN_PASSWORD=
